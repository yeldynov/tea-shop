# Neon Postgres connection string (use the pooled connection string from the Neon console)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Better Auth
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (redirect URI: $BETTER_AUTH_URL/api/auth/callback/google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe (use a sandbox; a restricted rk_ key needs write access to Checkout Sessions)
STRIPE_SECRET_KEY=""
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` locally, or the Dashboard endpoint in production
STRIPE_WEBHOOK_SECRET=""
